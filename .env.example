# ── Hardhat / deployment ────────────────────────────────────────────────────
# Deployer private key (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# Basescan API key for contract verification
BASESCAN_API_KEY=your_basescan_api_key_here

# Base Mainnet RPC (optional, defaults to public)
BASE_RPC_URL=https://mainnet.base.org

# ── Deployed contract addresses (Base Mainnet, chainId 8453) ───────────────
# These are the user-supplied contracts already on-chain.
ARENA_TOKEN_ADDRESS=0x3b855F88CB93aA642EaEB13F59987C552Fc614b5
ARENA_CHAMPION_ADDRESS=0x68f08b005b09B0F7D07E1c0B5CDe18E43CE2486A
ARENA_BATTLE_ADDRESS=0xF6fc2B6a306B626548ca9dF25B31a22D0f8971CF
ARENA_PVP_ADDRESS=0xd0C4Af12E95f9590e7314D079C58597771E57533
ARENA_MARKETPLACE_ADDRESS=0x67817157Dd6E5945ac2fAf1a822e7f1dE26C698E

# Not yet deployed (require ETH top-up to deploy):
ARENA_STAKING_ADDRESS=
ARENA_REWARD_VAULT_ADDRESS=
ARENA_LEADERBOARD_ADDRESS=

# ── ArenaCoinV2 deployment ─────────────────────────────────────────────────
# Set ARENA_TREASURY_ADDRESS to a Safe multisig (https://app.safe.global/).
# All initial supply and DEFAULT_ADMIN_ROLE go to this address — NEVER an EOA in production.
ARENA_TREASURY_ADDRESS=0x725615639B760DAa64b3e794AA49B5A9a8A7632E
ARENA_INITIAL_SUPPLY=1000000
ARENA_MAX_SUPPLY_CAP=100000000
# Comma-separated addresses to receive MINTER_ROLE (battle/staking/reward-vault contracts)
ARENA_GRANT_MINTER_TO=

# ── Base Sepolia (testnet) ────────────────────────────────────────────────
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# ── Frontend (Vite) testnet flags ─────────────────────────────────────────
# Set VITE_USE_TESTNET=true in artifacts/arena-protocol/.env.local for staging builds
VITE_USE_TESTNET=
VITE_BASE_RPC_URL=
VITE_BASE_SEPOLIA_RPC_URL=

# Legacy aliases (kept for backwards compat with the original deploy script)
ARENA_COIN_ADDRESS=0x3b855F88CB93aA642EaEB13F59987C552Fc614b5
ARENA_FIGHTER_NFT_ADDRESS=0x68f08b005b09B0F7D07E1c0B5CDe18E43CE2486A

# Deployer address (for verify.js)
DEPLOYER_ADDRESS=0xFfb6505912FCE95B42be4860477201bb4e204E9f

# ── Backend / database ─────────────────────────────────────────────────────
DATABASE_URL=
PORT=3001

# ── Frontend (Vite, prefix VITE_) ──────────────────────────────────────────
VITE_ARENA_TOKEN_ADDRESS=0x3b855F88CB93aA642EaEB13F59987C552Fc614b5
VITE_ARENA_CHAMPION_ADDRESS=0x68f08b005b09B0F7D07E1c0B5CDe18E43CE2486A
VITE_ARENA_BATTLE_ADDRESS=0xF6fc2B6a306B626548ca9dF25B31a22D0f8971CF
VITE_ARENA_PVP_ADDRESS=0xd0C4Af12E95f9590e7314D079C58597771E57533
VITE_ARENA_MARKETPLACE_ADDRESS=0x67817157Dd6E5945ac2fAf1a822e7f1dE26C698E
VITE_ARENA_STAKING_ADDRESS=
VITE_ARENA_REWARD_VAULT_ADDRESS=
VITE_ARENA_LEADERBOARD_ADDRESS=

# Telegram Bot Token (for Telegram Mini App)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
